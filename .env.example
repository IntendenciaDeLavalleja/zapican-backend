# --- Flask ---
FLASK_APP=wsgi.py
FLASK_ENV=production
SECRET_KEY=change-me-please
WTF_CSRF_SECRET_KEY=change-me-too

# --- Database (MariaDB) ---
# Ejemplo: mysql+mariadbconnector://user:pass@host:3306/lavalleja_cms
DATABASE_URL=mysql+mariadbconnector://lavalleja:lavalleja@db:3306/lavalleja_cms

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- Frontend / CORS ---
FRONTEND_URL=http://localhost:4321
# Lista CSV de orígenes permitidos para /api/*
CORS_ORIGINS=http://localhost:4321,https://lavalleja.example

# --- Mail (SMTP) ---
MAIL_SERVER=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=no-reply@lavalleja.example
MAIL_PASSWORD=
MAIL_USE_TLS=true
MAIL_USE_SSL=false
MAIL_DEFAULT_SENDER=Intendencia de Lavalleja <no-reply@lavalleja.example>

# --- MinIO ---
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=lavalleja-cms
MINIO_SECURE=false
# URL publica que sirve los objetos (Traefik/nginx delante de MinIO).
# Ej: https://media.lavalleja.example
MINIO_PUBLIC_URL=http://localhost:9000

# --- Prometheus ---
PROMETHEUS_MULTIPROC_DIR=/tmp/prometheus_multiproc_dir

# --- Coolify / container startup ---
RUN_DB_UPGRADE=true
DB_UPGRADE_RETRIES=12
DB_UPGRADE_RETRY_DELAY=5
RUN_BOOTSTRAP_ADMIN=false
GUNICORN_WORKERS=4
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=60
GUNICORN_LOG_LEVEL=info

# --- Admin bootstrap (opcional, comando flask create-admin) ---
ADMIN_BOOTSTRAP_USERNAME=admin
ADMIN_BOOTSTRAP_EMAIL=admin@lavalleja.example
ADMIN_BOOTSTRAP_PASSWORD=ChangeMe123!
